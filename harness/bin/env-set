#!/usr/bin/env node
// env-set: set variables in .env.local without reading it into the conversation.
//
//   harness/bin/env-set KEY=value [KEY=value ...]
//
// Agents are not allowed to read or edit .env files (see .claude/settings.json),
// so /setup uses this instead. It creates .env.local from .env.example when it
// does not exist, replaces the keys given, appends the ones that are missing
// and keeps every other line. It prints the names it set, never a value.

import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { resolve } from 'node:path';

const root = resolve(import.meta.dirname, '..', '..');
const target = resolve(root, '.env.local');
const example = resolve(root, '.env.example');

const pairs = process.argv.slice(2).map((arg) => {
  const at = arg.indexOf('=');
  const key = at > 0 ? arg.slice(0, at) : '';
  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) {
    console.error(`env-set: expected KEY=value, got "${at > 0 ? key : arg}"`);
    process.exit(2);
  }
  return [key, arg.slice(at + 1)];
});

if (pairs.length === 0) {
  console.error('usage: harness/bin/env-set KEY=value [KEY=value ...]');
  process.exit(2);
}

const created = !existsSync(target);
const lines = readFileSync(created ? example : target, 'utf8').split('\n');
const quote = (value) =>
  `"${value.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`;

for (const [key, value] of pairs) {
  const line = `${key}=${quote(value)}`;
  const at = lines.findIndex((l) => l.startsWith(`${key}=`));
  if (at >= 0) lines[at] = line;
  else {
    if (lines.at(-1) === '') lines.splice(-1, 0, line);
    else lines.push(line);
  }
}

writeFileSync(target, lines.join('\n'), { mode: 0o600 });
console.log(
  `env-set: ${created ? 'created .env.local and set' : 'set'} ${pairs.map(([k]) => k).join(', ')}`
);
