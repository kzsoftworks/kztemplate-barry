#!/usr/bin/env bash
# setup: one-time harness setup for an app created from this template.
#
#   harness/bin/setup <issue-prefix>
#
# Checks the tools the harness needs and initialises beads (the issue tracker
# that holds the work) with your prefix, e.g. `harness/bin/setup shop` gives
# issues named shop-a1b, shop-a1b.1, ...
#
# beads is initialised with --skip-agents: this repo already ships CLAUDE.md,
# AGENTS.md and the SessionStart hook that runs `bd prime`, so letting beads
# write its own would duplicate them. Safe to run again.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

prefix="${1:-}"
if [ -z "$prefix" ] || [ "$prefix" = "-h" ] || [ "$prefix" = "--help" ]; then
  sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 2
fi
if ! printf '%s' "$prefix" | grep -Eq '^[a-z][a-z0-9]{1,11}$'; then
  echo "setup: prefix must be 2-12 lowercase letters or digits, starting with a letter" >&2
  exit 2
fi

ok=1
check() { # name, install hint, required(1/0)
  if command -v "$1" >/dev/null 2>&1; then
    printf '  ✓ %s\n' "$1"
  elif [ "$3" -eq 1 ]; then
    printf '  ✖ %s missing: %s\n' "$1" "$2"
    ok=0
  else
    printf '  – %s not found (optional): %s\n' "$1" "$2"
  fi
}

echo "Tools:"
check node "install Node.js 22.12 or newer" 1
check git "install git" 1
check bd "npm i -g @beads/bd" 1
check docker "needed for the local Supabase stack (npm run db:start)" 0
check gh "needed to open pull requests from the terminal" 0
check vercel "npm i -g vercel (optional: the Git integration deploys by itself)" 0

if [ "$ok" -ne 1 ]; then
  echo "setup: install the missing tools and run this again." >&2
  exit 1
fi

if [ ! -d node_modules ]; then
  echo "Installing dependencies..."
  npm install
fi

echo "Initialising beads with prefix \"$prefix\"..."
bd init --prefix "$prefix" --non-interactive --skip-agents --init-if-missing

mkdir -p .harness

cat <<EOF

Harness ready.

  1. Copy .env.example to .env.local and fill it in (ASSISTANT_SETUP_GUIDE.md).
  2. Open Claude Code in this folder and run /intent to describe the product.
  3. Then /plan-to-beads to turn the first feature into an epic and issues.

Check the gates any time with: harness/bin/verify
EOF
