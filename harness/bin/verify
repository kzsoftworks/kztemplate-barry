#!/usr/bin/env bash
# verify: run the quality gates and record each result.
#
#   gate.typecheck  npm run typecheck
#   gate.lint       npm run lint
#   gate.test       npm test           (unit tests, Vitest)
#   gate.e2e        npm run test:e2e   (Playwright)
#   gate.db         npm run db:lint && npm run test:db   (only with --db)
#
# Every gate runs even if an earlier one fails, so one run reports everything.
# Each result (pass / fail / skip) is recorded with harness/bin/lf-score and the
# full output is kept in .harness/logs/. Exit code is 1 if any gate failed.
#
# Usage: harness/bin/verify [--no-e2e] [--db] [--only typecheck,lint,test,e2e,db]
#   --no-e2e   record gate.e2e as skip (CI runs e2e against the Preview instead)
#   --db       also run the database gate (needs Docker and `npm run db:start`)
#   --only     run just the listed gates; the others are recorded as skip
# Env: HARNESS_E2E=skip is the same as --no-e2e.

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT" || exit 2

LF_SCORE="$ROOT/harness/bin/lf-score"
LOG_DIR="${HARNESS_DIR:-$ROOT/.harness}/logs"
mkdir -p "$LOG_DIR"

run_e2e=1
run_db=0
only=""

while [ $# -gt 0 ]; do
  case "$1" in
    --no-e2e) run_e2e=0 ;;
    --db) run_db=1 ;;
    --only)
      shift
      only="${1:-}"
      [ -n "$only" ] || { echo "verify: --only needs a list" >&2; exit 2; }
      ;;
    -h | --help)
      sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "verify: unknown option $1" >&2
      exit 2
      ;;
  esac
  shift
done

[ "${HARNESS_E2E:-}" = "skip" ] && run_e2e=0

selected() {
  [ -z "$only" ] && return 0
  case ",$only," in *",$1,"*) return 0 ;; *) return 1 ;; esac
}

failed=0
summary=""

record() { # name result [comment]
  if [ -n "${3:-}" ]; then
    "$LF_SCORE" "gate.$1" "$2" --comment "$3" >/dev/null
  else
    "$LF_SCORE" "gate.$1" "$2" >/dev/null
  fi
  summary="${summary}$(printf '  %-10s %s%s' "$1" "$2" "${3:+  ($3)}")\n"
}

gate() { # name command...
  local name="$1"
  shift
  if ! selected "$name"; then
    record "$name" skip "not selected"
    return
  fi
  local log="$LOG_DIR/$name.log"
  echo "▶ gate.$name: $*"
  if "$@" >"$log" 2>&1; then
    record "$name" pass
  else
    failed=1
    record "$name" fail "see ${log#"$ROOT"/}"
    echo "✖ gate.$name failed. Last lines:"
    tail -n 30 "$log" | sed 's/^/    /'
  fi
}

"$LF_SCORE" phase verify >/dev/null

gate typecheck npm run --silent typecheck
gate lint npm run --silent lint
gate test npm test --silent

if [ "$run_e2e" -eq 1 ]; then
  gate e2e npm run --silent test:e2e
else
  record e2e skip "disabled for this run"
fi

if [ "$run_db" -eq 1 ]; then
  if ! command -v docker >/dev/null 2>&1; then
    record db skip "docker not available"
  elif ! npx --no-install supabase status >/dev/null 2>&1; then
    record db skip "local Supabase is not running (npm run db:start)"
  else
    gate db sh -c 'npm run --silent db:lint && npm run --silent test:db'
  fi
fi

echo
echo "Gates:"
printf '%b' "$summary"

if [ "$failed" -ne 0 ]; then
  echo "verify: FAILED"
  exit 1
fi
echo "verify: OK"
