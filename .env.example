# Copy to .env.local and fill in. Never commit real values.

# --- Supabase -------------------------------------------------------------
# Local values are printed by `npm run db:start`. On Vercel these are injected
# by the Supabase integration (per Preview branch and for Production).
NEXT_PUBLIC_SUPABASE_URL=""
# sb_publishable_... key. Safe in the browser; data access is governed by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# sb_secret_... key. Server only: bypasses RLS. Leave empty unless a server job needs it.
SUPABASE_SECRET_KEY=""

# Project ref of the PRODUCTION Supabase project (the subdomain of its URL).
# Set it in Vercel for the Preview environment: the build fails if a Preview
# deployment ends up pointing at production.
SUPABASE_PROD_PROJECT_REF=""

# --- App ------------------------------------------------------------------
# Public base URL. Optional: on Vercel it is derived from the deployment URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Sentry ---------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Build-time only (source map upload). Set it in Vercel and in CI, not here.
SENTRY_AUTH_TOKEN=""

# --- Agent tooling (.mcp.json) --------------------------------------------
# Export these in your shell (not in .env.local) before starting
# Claude Code to scope the MCP servers. Without them, the Supabase server points
# at the local stack and the Sentry server is not scoped to a project.
#
# Hosted Supabase project, read-only and limited to one project. Use a
# development project or a preview branch, never production:
#   SUPABASE_MCP_URL="https://mcp.supabase.com/mcp?project_ref=<ref>&read_only=true&features=database,docs,branching"
# Sentry, limited to one project:
#   SENTRY_MCP_URL="https://mcp.sentry.dev/mcp/<org-slug>/<project-slug>"
