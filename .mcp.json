{
  "mcpServers": {
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn", "mcp"]
    },
    "supabase": {
      "type": "http",
      "url": "${SUPABASE_MCP_URL:-http://localhost:54321/mcp}"
    },
    "sentry": {
      "type": "http",
      "url": "${SENTRY_MCP_URL:-https://mcp.sentry.dev/mcp}"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    }
  }
}
