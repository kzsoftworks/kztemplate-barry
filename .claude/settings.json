{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/hooks/session-start\""
          },
          {
            "type": "command",
            "command": "command -v bd >/dev/null 2>&1 && bd prime --hook-json || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run db:start)",
      "Bash(npm run db:reset)",
      "Bash(npm run db:lint)",
      "Bash(npm run db:types)",
      "Bash(harness/bin/verify:*)",
      "Bash(harness/bin/lf-score:*)",
      "Bash(harness/bin/env-set:*)",
      "Bash(bd:*)",
      "Bash(npx supabase migration new:*)",
      "Bash(npx supabase status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.sentry-build-plugin)",
      "Bash(npx supabase db push:*)",
      "Bash(npx supabase db reset --linked:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset --linked:*)"
    ]
  },
  "enableAllProjectMcpServers": false
}
